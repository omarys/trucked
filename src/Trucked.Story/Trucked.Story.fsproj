<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Trucked.Story</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="StoryTypes.fs" />
    <Compile Include="Bosses.fs" />
    <Compile Include="Policies.fs" />
    <Compile Include="StoryRunner.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qyl27.Ink.Engine" Version="1.2.0" />
    <PackageReference Include="Fornach.Engine" Version="$(FornachVersion)" />
    <PackageReference Include="Fornach.Domain" Version="$(FornachVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Scripts\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Scripts\prologue.ink.json" />
  </ItemGroup>
</Project>
