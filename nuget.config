<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      The engine, built from the sibling Fornach checkout with `dotnet pack`.
      Bump FornachVersion in Directory.Build.props after packing a new one.
    -->
    <add key="fornach-local" value="../fornach/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
